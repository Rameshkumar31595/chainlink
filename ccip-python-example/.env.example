# Private key for the account that will sign CCIP transactions (0x-prefixed hex string)
PRIVATE_KEY="0xYOUR_PRIVATE_KEY"

# RPC endpoint for the source chain (e.g., Sepolia via Infura or Alchemy)
RPC_URL="https://sepolia.infura.io/v3/YOUR_API_KEY"

# Address of the CCIP Router contract on the source chain
CCIP_ROUTER_ADDRESS="0xYourRouterAddress"

# Chain selector identifying the destination chain (Sepolia → Polygon Amoy shown)
DESTINATION_CHAIN_SELECTOR="16015286601757825753"

# Address on the destination chain that will receive the CCIP message or tokens
RECEIVER_ADDRESS="0xRecipientAddress"
